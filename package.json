{
	"name": "apple-photos-export",
	"version": "0.0.0",
	"description": "Export images from your macOS Photos.app library.",
	"keywords": [
		"apple",
		"photokit",
		"osxphotos",
		"photos"
	],
	"license": "MIT",
	"author": {
		"name": "Eric Mika",
		"email": "eric@ericmika.com",
		"url": "https://ericmika.com"
	},
	"type": "module",
	"scripts": {
		"build": "tsdown",
		"clean": "git rm -f pnpm-lock.yaml ; git clean -fdX",
		"fix": "kpi fix",
		"image-audit": "./scripts/image-audit.ts",
		"image-update-album-interactive": "./src/image-update.ts && ./src/image-update-extensions.ts",
		"image-update-credits-interactive": "./src/image-credits.ts",
		"lint": "kpi lint",
		"release": "bumpp --commit 'Release: %s' && pnpm run build && pnpm publish --otp $(op read 'op://Personal/Npmjs/one-time password?attribute=otp')",
		"test": "vitest"
	},
	"devDependencies": {
		"@clack/prompts": "^0.11.0",
		"@kitschpatrol/shared-config": "^5.4.2",
		"@sindresorhus/is": "^7.0.1",
		"@types/fs-extra": "^11.0.4",
		"camelcase-keys": "^9.1.3",
		"execa": "^9.6.0",
		"exiftool-vendored": "^30.2.0",
		"fs-extra": "^11.3.0",
		"github-slugger": "^2.0.0",
		"globby": "^14.1.0",
		"image-size": "^2.0.2",
		"importx": "^0.5.2",
		"markdown-table": "^3.0.4",
		"mrmime": "^2.0.1",
		"open": "^10.1.2",
		"piscina": "^5.0.0",
		"prettier": "^3.5.3",
		"pretty-bytes": "^7.0.0",
		"pretty-ms": "^9.2.0",
		"tsdown": "^0.12.6",
		"tsx": "^4.19.4",
		"vitest": "^3.1.4"
	},
	"packageManager": "pnpm@10.11.0",
	"engines": {
		"node": ">=21.2.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
