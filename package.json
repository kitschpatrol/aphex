{
	"name": "@kitschpatrol/aphex",
	"version": "0.1.1",
	"description": "Apple Photos Export. TypeScript library and CLI tool to export and process images and albums from your macOS Photos.app library.",
	"keywords": [
		"apple",
		"apple-photos",
		"photokit",
		"photos",
		"npm-package"
	],
	"homepage": "https://github.com/kitschpatrol/aphex",
	"bugs": "https://github.com/kitschpatrol/aphex/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kitschpatrol/aphex.git"
	},
	"license": "MIT",
	"author": {
		"name": "Eric Mika",
		"email": "eric@ericmika.com",
		"url": "https://ericmika.com"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"bin": {
		"aphex": "./dist/aphex-swift"
	},
	"files": [
		"dist/*"
	],
	"scripts": {
		"build": "pnpm --sequential /^build:/",
		"build:1-lib": "tsdown",
		"build:2-native": "cd native/aphex-swift && ./build.sh",
		"build:3-publint": "publint",
		"clean": "git rm -f pnpm-lock.yaml && git clean -fdX -e !.claude/",
		"fix": "ksc fix && mdat ./native/aphex-swift/readme.md",
		"lint": "ksc lint",
		"release": "bumpp --commit 'Release: %s' && pnpm build && NPM_AUTH_TOKEN=$(op read 'op://Personal/npm/token') pnpm publish",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage"
	},
	"dependencies": {
		"@sindresorhus/is": "^8.1.0",
		"defu": "^6.1.7",
		"execa": "^9.6.1",
		"exiftool-vendored": "^35.20.0",
		"fast-equals": "^6.0.0",
		"fs-extra": "^11.3.5",
		"github-slugger": "^2.0.0",
		"image-size": "^2.0.2",
		"importx": "^0.5.2",
		"lognow": "^0.6.2",
		"mrmime": "^2.0.1",
		"piscina": "^5.1.4",
		"type-fest": "^5.6.0"
	},
	"devDependencies": {
		"@arethetypeswrong/core": "^0.18.2",
		"@clack/prompts": "^1.4.0",
		"@kitschpatrol/shared-config": "^7.6.0",
		"@types/fs-extra": "^11.0.4",
		"@types/node": "~22.18.13",
		"@vitest/coverage-v8": "^4.1.6",
		"bumpp": "^11.1.0",
		"globby": "^16.2.0",
		"markdown-table": "^3.0.4",
		"mdat-plugin-cli-help": "^3.0.0",
		"open": "^11.0.0",
		"pretty-bytes": "^7.1.0",
		"pretty-ms": "^9.3.0",
		"publint": "^0.3.21",
		"tsdown": "^0.22.0",
		"tsx": "^4.22.0",
		"vitest": "^4.1.6"
	},
	"packageManager": "pnpm@11.1.2",
	"engines": {
		"node": ">=22.18.0"
	},
	"os": [
		"darwin"
	],
	"cpu": [
		"arm64"
	],
	"publishConfig": {
		"access": "public"
	}
}
