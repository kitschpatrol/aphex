{
	"name": "@kitschpatrol/aphex",
	"version": "0.0.0",
	"description": "Apple Photos Export. TypeScript library to export and process images and albums from your macOS Photos.app library.",
	"keywords": [
		"apple",
		"apple-photos",
		"photokit",
		"photos",
		"npm-package"
	],
	"homepage": "https://github.com/kitschpatrol/aphex",
	"bugs": "https://github.com/kitschpatrol/aphex/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kitschpatrol/aphex.git"
	},
	"license": "MIT",
	"author": {
		"name": "Eric Mika",
		"email": "eric@ericmika.com",
		"url": "https://ericmika.com"
	},
	"type": "module",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		}
	},
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"bin": {
		"aphex": "./dist/aphex-swift"
	},
	"files": [
		"dist/*"
	],
	"scripts": {
		"build": "pnpm run --sequential /^build:/",
		"build:1-lib": "tsdown --no-fixed-extension --copy ./src/assets",
		"build:2-native": "cd native/aphex-swift && ./build.sh",
		"clean": "git rm -f pnpm-lock.yaml ; git clean -fdX",
		"fix": "ksc fix ; mdat readme ./native/aphex-swift/readme.md",
		"lint": "ksc lint",
		"release": "bumpp --commit 'Release: %s' && pnpm run build && NPM_AUTH_TOKEN=$(op read 'op://Personal/npm/token') && pnpm publish",
		"test": "vitest",
		"test:coverage": "vitest run --coverage"
	},
	"dependencies": {
		"piscina": "^5.1.3",
		"type-fest": "^5.2.0"
	},
	"devDependencies": {
		"@clack/prompts": "^0.11.0",
		"@kitschpatrol/shared-config": "^5.8.1",
		"@sindresorhus/is": "^7.1.1",
		"@types/fs-extra": "^11.0.4",
		"@types/node": "~20.19.24",
		"@vitest/coverage-v8": "^4.0.7",
		"defu": "^6.1.4",
		"execa": "^9.6.0",
		"exiftool-vendored": "^31.3.0",
		"fast-equals": "^5.3.2",
		"fs-extra": "^11.3.2",
		"github-slugger": "^2.0.0",
		"globby": "^15.0.0",
		"image-size": "^2.0.2",
		"importx": "^0.5.2",
		"markdown-table": "^3.0.4",
		"mdat-plugin-cli-help": "^1.0.2",
		"mrmime": "^2.0.1",
		"open": "^10.2.0",
		"prettier": "^3.6.2",
		"pretty-bytes": "^7.1.0",
		"pretty-ms": "^9.3.0",
		"tsdown": "^0.16.0",
		"tsx": "^4.20.6",
		"vitest": "^4.0.7"
	},
	"packageManager": "pnpm@10.20.0",
	"engines": {
		"node": ">=20.19.0"
	},
	"os": [
		"darwin"
	],
	"cpu": [
		"arm64"
	],
	"publishConfig": {
		"access": "public"
	}
}
