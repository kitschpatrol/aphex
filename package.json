{
	"name": "@kitschpatrol/aphex",
	"version": "0.0.0",
	"description": "Apple Photos Export. TypeScript library to export and process images and albums from your macOS Photos.app library.",
	"keywords": [
		"apple",
		"photokit",
		"photos"
	],
	"homepage": "https://github.com/kitschpatrol/aphex",
	"bugs": "https://github.com/kitschpatrol/aphex/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kitschpatrol/aphex.git"
	},
	"license": "MIT",
	"author": {
		"name": "Eric Mika",
		"email": "eric@ericmika.com",
		"url": "https://ericmika.com"
	},
	"type": "module",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		}
	},
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"bin": {
		"aphex": "./dist/aphex-swift"
	},
	"files": [
		"dist/*"
	],
	"scripts": {
		"build": "pnpm run --sequential /^build:/",
		"build:1-lib": "tsdown && cp ./src/pipeline/engines/applescript-gui.applescript ./dist",
		"build:2-native": "cd native/aphex-swift && ./build.sh",
		"clean": "git rm -f pnpm-lock.yaml ; git clean -fdX",
		"fix": "ksc fix",
		"lint": "ksc lint",
		"release": "bumpp --commit 'Release: %s' && pnpm run build && pnpm publish --otp $(op read 'op://Personal/Npmjs/one-time password?attribute=otp')",
		"test": "vitest"
	},
	"dependencies": {
		"type-fest": "^5.0.0"
	},
	"devDependencies": {
		"@clack/prompts": "^0.11.0",
		"@kitschpatrol/shared-config": "^5.7.0",
		"@sindresorhus/is": "^7.1.0",
		"@types/fs-extra": "^11.0.4",
		"defu": "^6.1.4",
		"execa": "^9.6.0",
		"exiftool-vendored": "^30.5.0",
		"fast-equals": "^5.2.2",
		"fs-extra": "^11.3.2",
		"github-slugger": "^2.0.0",
		"globby": "^14.1.0",
		"image-size": "^2.0.2",
		"importx": "^0.5.2",
		"markdown-table": "^3.0.4",
		"mrmime": "^2.0.1",
		"open": "^10.2.0",
		"package-directory": "^8.1.0",
		"piscina": "^5.1.3",
		"prettier": "^3.6.2",
		"pretty-bytes": "^7.0.1",
		"pretty-ms": "^9.3.0",
		"tsdown": "^0.15.2",
		"tsx": "^4.20.5",
		"vitest": "^3.2.4"
	},
	"packageManager": "pnpm@10.17.0",
	"engines": {
		"node": ">=20.19.0"
	},
	"os": [
		"darwin"
	],
	"cpu": [
		"arm64"
	],
	"publishConfig": {
		"access": "public"
	}
}
